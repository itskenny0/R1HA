<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy (pre-API-26) round launcher icon. Same composite as ic_launcher; the
  android:roundIcon manifest attribute is itself only read on API 25+, but a
  handful of 25 launchers request it, so we mirror the square fallback here.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background"/>
    <item android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
