<?xml version="1.0" encoding="utf-8"?>
<!--
  Favorite-card widget layout. A single ImageView because the card body is a
  Canvas-drawn Bitmap (RemoteViews can't host Compose and a TextView stack
  can't reproduce the in-app card chrome); the provider swaps the bitmap on
  every refresh via setImageViewBitmap and keeps the contentDescription in
  sync with the rendered name and state for accessibility. The image scales
  with fitCenter, not fitXY, so a launcher that mis-reports the cell aspect
  (some FireOS launchers do) letterboxes the card against the transparent
  background instead of stretching it vertically. The root carries the single
  tap target so the whole cell, padding included, responds.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favorite_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/favorite_card_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_favorite_card_label"/>
</FrameLayout>
