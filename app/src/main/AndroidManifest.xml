<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Microphone access for the voice satellite. Requested at runtime when
         the user opens the satellite screen; we never record outside that
         surface, and the surface itself shows a permission rationale dialog
         before triggering the system prompt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- Camera access for IoT Camera Mode — opt-in feature that turns the
         device's camera into a Home Assistant camera entity (MJPEG over HTTP
         and/or MQTT auto-discovery). The runtime permission is only requested
         when the user enables the master toggle under Settings → IoT Camera
         Mode; installs that never flip it on never see the prompt. Hardware
         is declared optional so the app still installs on devices without a
         camera (a few low-end tablets, headless dev boxes). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>

    <!-- NFC reading. Optional hardware: the NFC features still work when
         present but we don't require it, so the app installs on phones
         and tablets that don't ship with an NFC controller. -->
    <uses-permission android:name="android.permission.NFC"/>
    <uses-feature android:name="android.hardware.nfc" android:required="false"/>

    <!-- BLE peripheral advertising (iBeacon). BLUETOOTH_ADVERTISE is the
         Android-12+ runtime permission; the legacy BLUETOOTH permission
         is needed for older API levels. neverForLocation tells the OS we
         only advertise, never scan, so we don't need fine-location too. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31"/>
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false"/>
    <!-- Required for Android 13+ to post the HA persistent-notification mirror.
         Users opt in via the toggle under Advanced; we only request the runtime
         permission when they enable the mirror, so installs that don't use the
         feature never see the prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Foreground service to host the webhook listener. Required on Android
         8+ for any indefinitely-running socket holder; the service shows a
         persistent notification so the user knows why we're staying alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34"/>
    <!-- Foreground-service subtype required on Android 14+ for any FGS that
         actively holds the camera open. The IoT Camera Mode service uses this
         type because it must keep the Camera2 session alive while the app is
         backgrounded (kiosk / desk-tablet use case); without the subtype +
         permission the OS would crash the service at startForeground(). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        tools:targetApi="34"/>
    <!-- IoT Sensors Mode foreground-service subtype. "specialUse" is the
         catch-all bucket for FGS that doesn't fit camera / mic / location;
         we use it because the sensor service holds an MQTT socket open and
         registers SensorManager listeners but doesn't touch any of the
         privileged-FGS subsystems. Required on Android 14+. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34"/>
    <!-- Write to Settings.System.SCREEN_BRIGHTNESS for the IoT Sensors
         brightness control. Special-permission grant (not the standard
         runtime prompt) — the user opens system Settings → "Modify system
         settings" and toggles us in. We surface a GRANT button on the
         settings screen that fires ACTION_MANAGE_WRITE_SETTINGS to skip
         them straight there. Pre-grant the permission is silently denied
         and the brightness command logs + surfaces a notification. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions"/>
    <!-- Needed for the in-app self-update flow: after we download a newer APK from
         GitHub Releases we fire ACTION_VIEW with a content:// URI, which Android's
         PackageInstaller honours only when the source app holds this permission.
         The user still has to confirm the install in the OS prompt — we never
         silently install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Resolve other apps that can handle ACTION_VIEW for our APK content URI
         (i.e. the package installer). On Android 11+ the system requires this
         declaration before queryIntentActivities returns anything useful. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/vnd.android.package-archive"/>
        </intent>
        <!-- Resolve a system speech recognizer so the Assist mic button can hide
             itself when none is installed (some R1 ROMs ship no recognizer). On
             Android 11+ this declaration is required before resolveActivity sees
             the recognition app. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>

    <!-- Declare support for all screen sizes so OEM tablet shells (Samsung DeX,
         Xiaomi Pad, etc.) don't apply their own portrait-phone letterbox compat
         mode. Without this, some builds ignore android:resizeableActivity and
         show the app as a small phone-sized island on large screens. -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:resizeable="true" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.R1ha">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="r1ha" android:host="auth-callback"/>
            </intent-filter>
            <!-- App-shortcut definitions for the launcher pop-up. The
                 four shortcuts (Search / Assist / Today / Automations)
                 launch MainActivity with an 'initial_route' extra that
                 the activity reads on resume and routes through the
                 existing nav graph. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Quick Settings tiles — mirror up to four HA entities' on/off state in
             the Android notification-shade Quick Settings panel. Each tile binds
             to a separate entity_id slot in Settings → BEHAVIOUR; slot A is the
             legacy default, B/C/D expose extra bindings for users with more than
             one "tile-worthy" entity. Each tile needs its own TileService class
             because Android binds tiles by class name. -->
        <service
            android:name=".feature.quicktile.HaQuickTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false"/>
        </service>
        <service
            android:name=".feature.quicktile.HaQuickTileServiceB"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_tile_label_b"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false"/>
        </service>
        <service
            android:name=".feature.quicktile.HaQuickTileServiceC"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_tile_label_c"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false"/>
        </service>
        <service
            android:name=".feature.quicktile.HaQuickTileServiceD"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/quick_tile_label_d"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="24">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false"/>
        </service>

        <!-- IoT Camera Mode foreground service. Owns the Camera2 session and
             both sinks (MJPEG HTTP server + MQTT publisher) so frames keep
             flowing while the app is backgrounded. foregroundServiceType is
             "camera" because the service holds the camera open; Android 14+
             requires both the type declaration here and the matching
             FOREGROUND_SERVICE_CAMERA runtime permission above. Off by
             default; the App.onCreate observer brings it up only when
             integrations.iotCamera.enabled flips true. -->
        <service
            android:name=".core.iotcamera.IotCameraService"
            android:exported="false"
            android:foregroundServiceType="camera"/>

        <!-- IoT Sensors Mode foreground service. Owns the bidirectional MQTT
             session that publishes device sensors (battery / light /
             vibration / screen / SSID) and accepts commands (flashlight /
             brightness / volume / lock). foregroundServiceType "specialUse"
             with the matching FOREGROUND_SERVICE_SPECIAL_USE permission is
             the Android-14+ bucket for FGS that doesn't fit camera / mic /
             location. property below is the OS-required explanation that
             ships with specialUse declarations. Off by default; the
             App.onCreate observer brings it up only when
             iotSensors.enabled flips true. -->
        <service
            android:name=".core.iotsensors.IotSensorsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Publishes device sensors and accepts commands via MQTT for Home Assistant integration"/>
        </service>

        <!-- Device Admin receiver — only used by IoT Sensors Mode's
             "Lock screen" entity, which calls DevicePolicyManager.lockNow().
             Activation is user-initiated via the settings screen, and the
             meta-data XML declares only the force-lock policy so the grant
             prompt is minimal. -->
        <receiver
            android:name=".core.iotsensors.LockAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_lock"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>

        <!-- Webhook listener foreground service. Opens a configurable TCP port
             (default 8765) so HA can POST automation webhooks at the device.
             Off until the user opts in under Dev menu > WEBHOOK. -->
        <service
            android:name=".core.webhook.WebhookListenerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Background-refresh JobService. Wakes the app every ~15 min (subject to
             Doze) and warms the HA entity cache via /api/states. Opt-in via the
             Advanced setting; never scheduled by default to avoid the battery hit
             on users who never see the benefit. -->
        <service
            android:name=".core.background.BackgroundRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"/>

        <!-- Home-screen widget — a single-tile quick-launch shortcut. Tap opens
             MainActivity. No live data binding (RemoteViews + Doze would fight),
             so think of this as a launcher tile with the app's iconography. -->
        <receiver
            android:name=".feature.widget.R1haWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/r1ha_widget_info"/>
        </receiver>

        <!-- DISMISS-action receiver for the HA notification mirror. Fired when the
             user taps the DISMISS button on a mirrored notification; routes to
             persistent_notification.dismiss via the existing repository. -->
        <receiver
            android:name=".core.notifications.HaNotificationMirror$DismissActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.github.itskenny0.r1ha.action.DISMISS_HA_NOTIF"/>
            </intent-filter>
        </receiver>

        <!-- External-automation broadcast receiver. Lets Tasker / MacroDroid /
             Automate fire HA service calls through our already-configured client
             by broadcasting the action below with ha_domain + ha_service extras.
             Exported so cross-app intents reach us; the receiver itself rejects
             the broadcast unless the user has enabled the opt-in toggle under
             Advanced settings, so a fresh install can't be hijacked. -->
        <receiver
            android:name=".core.extern.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.github.itskenny0.r1ha.action.HA_SERVICE_CALL"/>
            </intent-filter>
        </receiver>

        <!-- FileProvider for the in-app update flow — exposes the downloaded APK
             from cache as a content:// URI that the package installer can read.
             Authority matches applicationId + ".updates" so it stays unique to
             this app even if installed alongside another build. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/updates_paths"/>
        </provider>
    </application>
</manifest>
